{
    "name": "latex-sync-follow",
    "displayName": "LaTeX Live Preview",
    "description": "Live LaTeX preview tab rendered while you type (no PDF build), with word-accurate source <-> preview navigation and on-demand PDF export through LaTeX Workshop.",
    "version": "0.2.0",
    "publisher": "local",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yinlin49/latex-sync-follow.git"
    },
    "homepage": "https://github.com/yinlin49/latex-sync-follow#readme",
    "bugs": {
        "url": "https://github.com/yinlin49/latex-sync-follow/issues"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:latex",
        "onLanguage:latex-expl3",
        "onLanguage:doctex",
        "onWebviewPanel:latexLivePreview"
    ],
    "extensionDependencies": [
        "james-yu.latex-workshop"
    ],
    "contributes": {
        "commands": [
            {
                "command": "latexLivePreview.open",
                "title": "Open Live Preview",
                "category": "LaTeX",
                "icon": "$(open-preview)"
            },
            {
                "command": "latexLivePreview.exportPdf",
                "title": "Export PDF",
                "category": "LaTeX",
                "icon": "$(file-pdf)"
            },
            {
                "command": "latexLivePreview.showStats",
                "title": "Show Live Preview Latency Stats",
                "category": "LaTeX"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "latexLivePreview.open",
                    "when": "editorLangId == latex",
                    "group": "navigation@1"
                },
                {
                    "command": "latexLivePreview.exportPdf",
                    "when": "editorLangId == latex || activeWebviewPanelId == 'latexLivePreview'",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "scripts": {
        "build": "node build.mjs",
        "vscode:prepublish": "node build.mjs",
        "lint": "eslint . --ignore-pattern .gitnexus/",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p jsconfig.json",
        "test": "node --test test/preview.test.mjs",
        "e2e": "node test/e2e-preview.js",
        "package": "vsce package",
        "verify:vsix": "node scripts/verify-vsix.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/vscode": "^1.145.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "ovsx": "^1.3.0",
        "playwright-core": "^1.50.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@unified-latex/unified-latex-to-hast": "^1.8.4",
        "@unified-latex/unified-latex-util-arguments": "^1.8.4",
        "@unified-latex/unified-latex-util-html-like": "^1.8.4",
        "@unified-latex/unified-latex-util-macros": "^1.8.4",
        "@unified-latex/unified-latex-util-parse": "^1.8.4",
        "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
        "hast-util-to-html": "^9.0.6",
        "katex": "^0.19.1",
        "unified": "^10.1.2"
    }
}
